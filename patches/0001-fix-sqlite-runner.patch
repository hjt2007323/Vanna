+
+
+def test_connection_released_after_query_error(tmp_path: Path) -> None:
+    path = tmp_path / "lifecycle.db"
+    conn = sqlite3.connect(str(path))
+    try:
+        conn.executescript(SEED_SQL)
+        conn.commit()
+    finally:
+        conn.close()
